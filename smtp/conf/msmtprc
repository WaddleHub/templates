# msmtp configuration for the SMTP relay.
#
# The relay receives mail from the project's services (PHP, Node, etc.) on the
# internal network and forwards it to the external SMTP server configured below.
#
# The account password is intentionally NOT stored here. It is injected into
# the container environment as SMTP_PASSWORD via the remote's .env file at
# deploy time and read at send time with `passwordeval` below, so the secret
# never lands in a committed file.
defaults
logfile {{project_path 'smtp/log/msmtp.log'}}

account default
host {{public.smtp.host}}
port {{public.smtp.port}}
from "{{public.smtp.from}}"
allow_from_override off
{{#if (is_equal public.smtp.security "none")}}
tls off
auth off
{{else}}
tls on
auth on
user "{{public.smtp.username}}"
passwordeval printenv SMTP_PASSWORD
{{#if (is_equal public.smtp.security "starttls")}}
tls_starttls on
{{else}}
tls_starttls off
{{/if}}
{{/if}}
