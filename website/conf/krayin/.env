APP_NAME="{{public.website.title}}"
APP_ENV=local
APP_KEY={{private.secrets.krayin_app_key}}
APP_DEBUG=true
APP_URL={{website_url}}
APP_TIMEZONE={{timezone}}
APP_LOCALE={{public.website.language}}
APP_CURRENCY={{public.website.currency}}

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE={{public.website.db_name}}
DB_USERNAME={{private.website_credentials.db_username}}
DB_PASSWORD={{private.website_credentials.db_password}}
DB_PREFIX=

BROADCAST_DRIVER=log
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

{{#if public.redis.install}}
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
{{else}}
CACHE_DRIVER=file
SESSION_DRIVER=file
{{/if}}

MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT={{public.mail.smtp_port}}
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="{{coalesce public.mail.from_email public.website.admin_email}}"
MAIL_FROM_NAME="${APP_NAME}"

IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
