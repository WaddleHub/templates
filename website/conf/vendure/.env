# "dev" locally, "prod" on remote environments (where the dashboard is served from its build,
# and CORS_ORIGINS applies).
APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET="{{private.secrets.vendure_cookie_secret}}"
# The superadmin account, created on the first start with an empty database. Changing these later
# creates another superadmin rather than changing the existing one's credentials.
SUPERADMIN_USERNAME="{{public.website.admin_email}}"
SUPERADMIN_PASSWORD="{{private.website_credentials.admin_password}}"
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
DB_HOST=db
DB_PORT=3306
DB_NAME="{{public.website.db_name}}"
DB_USERNAME="{{private.website_credentials.db_username}}"
DB_PASSWORD="{{private.website_credentials.db_password}}"

# The shop's public URL, read by vendure-config.ts for the asset URLs and the links in emails.
SITE_URL={{website_url}}

# Mail. With SMTP_HOST set, emails go to the project's mail service; without it (mail turned off),
# they're saved to static/email/test-emails, viewable at /mailbox.
{{#if public.mail.enabled}}
SMTP_HOST=mail
SMTP_PORT={{public.mail.smtp_port}}
{{/if}}
MAIL_FROM="{{coalesce public.mail.from_email public.website.admin_email}}"
