HOST=0.0.0.0
PORT=1337
PUBLIC_URL={{website_url}}

# Secrets
APP_KEYS="{{private.secrets.strapi_app_key_1}},{{private.secrets.strapi_app_key_2}},{{private.secrets.strapi_app_key_3}},{{private.secrets.strapi_app_key_4}}"
API_TOKEN_SALT={{private.secrets.strapi_api_token_salt}}
ADMIN_JWT_SECRET={{private.secrets.strapi_admin_jwt_secret}}
TRANSFER_TOKEN_SALT={{private.secrets.strapi_transfer_token_salt}}
JWT_SECRET={{private.secrets.strapi_jwt_secret}}
ENCRYPTION_KEY={{private.secrets.strapi_encryption_key}}

# Database
{{#if public.mariadb.install}}
DATABASE_CLIENT=mysql
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME={{public.website.db_name}}
DATABASE_USERNAME="{{private.website_credentials.db_username}}"
DATABASE_PASSWORD="{{private.website_credentials.db_password}}"
DATABASE_SSL=false
{{else}}
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
{{/if}}

{{#if public.mail.enabled}}
# Mail, sent over SMTP to the project's `mail` service (MailCatcher locally, SMTP relay on remotes).
# Read by config/plugins.ts, which leaves Strapi's default (sendmail) provider in place when
# SMTP_HOST is unset.
SMTP_HOST=mail
SMTP_PORT={{public.mail.smtp_port}}
MAIL_FROM="{{coalesce public.mail.from_email public.website.admin_email}}"
MAIL_REPLY_TO="{{public.website.admin_email}}"
{{/if}}
