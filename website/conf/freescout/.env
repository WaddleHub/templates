APP_NAME="FreeScout"
APP_ENV=local
APP_KEY={{private.secrets.freescout_app_key}}
APP_URL={{website_url}}

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE={{public.website.db_name}}
DB_USERNAME="{{private.website_credentials.db_username}}"
DB_PASSWORD="{{private.website_credentials.db_password}}"

REDIS_CLIENT=phpredis

{{#if public.redis.install}}
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
{{else}}
CACHE_DRIVER=file
SESSION_DRIVER=file
{{/if}}

MAIL_DRIVER=smtp
MAIL_HOST=mail
MAIL_PORT={{public.mail.smtp_port}}
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="{{coalesce public.mail.from_email public.website.admin_email}}"
MAIL_FROM_NAME="FreeScout"
