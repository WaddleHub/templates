APP_NAME="{{public.website.title}}"
APP_ENV=prod
APP_KEY={{private.secrets.uvdesk_app_key}}
APP_DEBUG=true
APP_URL={{website_url}}
APP_TIMEZONE={{timezone}}
LOG_CHANNEL=stack

# Symfony app secret — populated at install time from composer create-project output.
APP_SECRET=

# Session cookie/GC lifetime in seconds (UVdesk-specific env var).
UV_SESSION_COOKIE_LIFETIME=1440

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE={{public.website.db_name}}
DB_USERNAME="{{private.website_credentials.db_username}}"
DB_PASSWORD="{{private.website_credentials.db_password}}"
DB_PREFIX=

DATABASE_URL="mysql://{{private.website_credentials.db_username}}:{{private.website_credentials.db_password}}@db:3306/{{public.website.db_name}}"

BROADCAST_DRIVER=log
QUEUE_DRIVER=sync
SESSION_LIFETIME=20

{{#if public.redis.install}}
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
{{else}}
CACHE_DRIVER=filesystem
SESSION_DRIVER=filesystem
{{/if}}

MAIL_DRIVER=smtp
MAIL_HOST=mail
MAIL_PORT={{public.mail.smtp_port}}
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="{{coalesce public.mail.from_email public.website.admin_email}}"
MAIL_FROM_NAME="${APP_NAME}"

# Symfony mailer DSN (symfony/mailer) and SwiftMailer URL — both point to the mail service.
MAILER_DSN=smtp://mail:{{public.mail.smtp_port}}
MAILER_URL=smtp://mail:{{public.mail.smtp_port}}
