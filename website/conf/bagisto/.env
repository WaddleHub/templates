APP_NAME="{{public.website.title}}"
APP_ENV=local
APP_KEY={{private.secrets.bagisto_app_key}}
APP_DEBUG=true
APP_DEBUG_ALLOWED_IPS=
APP_URL={{website_url}}
APP_ADMIN_URL="{{public.website.admin_route}}"
APP_TIMEZONE={{timezone}}

APP_LOCALE="{{public.website.language}}"
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY="{{public.website.currency}}"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE={{public.website.db_name}}
DB_USERNAME="{{private.website_credentials.db_username}}"
DB_PASSWORD="{{private.website_credentials.db_password}}"
DB_PREFIX=

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis

{{#if public.redis.install}}
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
{{else}}
CACHE_STORE=file
SESSION_DRIVER=file
{{/if}}

RESPONSE_CACHE_ENABLED=true

MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT={{public.mail.smtp_port}}
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="{{coalesce public.mail.from_email public.website.admin_email}}"
MAIL_FROM_NAME="{{public.website.admin_firstname}} {{public.website.admin_lastname}}"

ADMIN_MAIL_ADDRESS="{{public.website.admin_email}}"
ADMIN_MAIL_NAME="{{public.website.admin_firstname}} {{public.website.admin_lastname}}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_HOST=localhost
VITE_PORT=
