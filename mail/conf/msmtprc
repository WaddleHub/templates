# msmtp client configuration used by PHP's sendmail_path.
#
# Routes mail from PHP/Node/etc. to the project's `mail` service over the internal Docker network.
# That service is MailCatcher locally and the SMTP relay on remotes — both listen on the same
# internal endpoint, so this configuration is identical in every environment. No credentials live
# here: the `mail` service is on the trusted project network, and any real authentication to an
# external provider happens inside the relay, not here.
defaults
tls off
auth off
logfile {{project_path 'php/log/msmtp.log'}}

account default
host mail
port {{public.mail.smtp_port}}
from "{{coalesce public.mail.from_email public.website.admin_email}}"
