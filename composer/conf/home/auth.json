{
  "http-basic": {
{{#if (is_equal public.website.platform 'magento')}}
    "repo.magento.com": {
      "username": "{{settings.magento_public_key}}",
      "password": "{{settings.magento_private_key}}"
    }
{{/if}}
  }{{#if (not_empty settings.github_token)}},
  "github-oauth": {
    "github.com": "{{settings.github_token}}"
  }{{/if}}
}
